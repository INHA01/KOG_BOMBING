#node-border {
    background-color: rgb(67, 67, 67);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
}

#input {
    align-items: center;
}

#output {
    justify-content: flex-start;
    align-items: center;
}

#selection-border {
    border-left-color: rgb(109, 175, 254);
    border-right-color: rgb(109, 175, 254);
    border-top-color: rgb(109, 175, 254);
    border-bottom-color: rgb(109, 175, 254);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

:hover > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:selected > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:hover:selected > #selection-border {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.node {
    min-width: 150px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    min-height: 50px;
}

#title {
    -unity-font-style: bold;
}

#description {
    font-size: 10px;
}

#divider {
    min-height: 2px;
    background-color: rgb(84, 84, 84);
}

.action #input {
    background-color: rgb(255, 88, 88);
}

.composite #input {
    background-color: rgb(255, 207, 90);
}

.decorator #input {
    background-color: rgb(88, 158, 255);
}

.root #input {
    background-color: rgb(90, 209, 126);
    min-height: 20px;
}
